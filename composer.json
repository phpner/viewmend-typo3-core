{
  "name": "viewmend/typo3-core",
  "description": "Shared TYPO3 backend shell and product registry for ViewMend extensions.",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "homepage": "https://viewmend.com/",
  "keywords": [
    "dashboard",
    "extension-ecosystem",
    "product-registry",
    "typo3",
    "viewmend"
  ],
  "authors": [
    {
      "name": "ViewMend",
      "email": "support@viewmend.com",
      "homepage": "https://viewmend.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "support@viewmend.com",
    "issues": "https://github.com/phpner/viewmend-typo3-core/issues",
    "source": "https://github.com/phpner/viewmend-typo3-core"
  },
  "require": {
    "php": ">=8.2 <8.6",
    "typo3/cms-backend": "~13.4.0 || ~14.3.0",
    "typo3/cms-core": "~13.4.0 || ~14.3.0",
    "typo3/cms-extbase": "~13.4.0 || ~14.3.0",
    "typo3/cms-fluid": "~13.4.0 || ~14.3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.87",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "ViewMend\\Typo3Core\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ViewMend\\Typo3Core\\Tests\\": "Tests/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "viewmend_core"
    }
  },
  "archive": {
    "exclude": [
      "/.gitattributes",
      "/.gitignore",
      "/.github",
      "/.idea",
      "/.php-cs-fixer.dist.php",
      "/.phpstan-cache",
      "/.phpunit.cache",
      "/composer.lock",
      "/phpstan.neon",
      "/phpunit.xml",
      "/Tests",
      "/vendor"
    ]
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "analyse": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "lint": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php --sequential"
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "sort-packages": true
  }
}
